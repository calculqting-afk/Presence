rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSuperAdmin() || isHeadAdmin() || isAttendanceAdmin() || isStudentManager();
    }

    // The bootstrap email is the protected Super Admin account. Other roles are kept
    // on each user's student profile so this works without Cloud Functions.
    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.uid == "8uEjAk72BLWKjvnQJEatBdeVAi02"
          || request.auth.token.email == "mikhailovna2007@gmail.com"
        );
    }

    function hasStoredRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.keys().hasAll(["role"])
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == role;
    }

    function isHeadAdmin() {
      return hasStoredRole("head_admin");
    }

    function isAttendanceAdmin() {
      return hasStoredRole("attendance_admin");
    }

    function isStudentManager() {
      return hasStoredRole("student_manager");
    }

    function canManageStudents() {
      return isSuperAdmin() || isHeadAdmin() || isStudentManager();
    }

    function canManageAttendance() {
      return isSuperAdmin() || isHeadAdmin() || isAttendanceAdmin();
    }

    function canViewAttendanceReports() {
      return isSuperAdmin() || isHeadAdmin() || isAttendanceAdmin() || isStudentManager();
    }

    function canViewFines() {
      return isSuperAdmin() || isHeadAdmin() || isStudentManager();
    }

    function canManageFines() {
      return isSuperAdmin() || isHeadAdmin();
    }

    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.active == true;
    }

    function shortText(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function optionalShortText(data, key, maximum) {
      return !(key in data) || shortText(data[key], maximum);
    }

    function validGeofence(geofence) {
      return geofence is map
        && geofence.keys().hasOnly(["enabled", "latitude", "longitude", "radiusMeters", "address"])
        && geofence.keys().hasAll(["enabled"])
        && geofence.enabled is bool
        && optionalShortText(geofence, "address", 500)
        && (!geofence.enabled || (
          geofence.keys().hasAll(["latitude", "longitude", "radiusMeters"])
          && geofence.latitude is number && geofence.latitude >= -90 && geofence.latitude <= 90
          && geofence.longitude is number && geofence.longitude >= -180 && geofence.longitude <= 180
          && geofence.radiusMeters is number && geofence.radiusMeters > 0 && geofence.radiusMeters <= 10000
        ));
    }

    function validEvent(data) {
      return data.keys().hasOnly([
          "name", "type", "date", "location", "timeIn", "checkInCutoff", "timeOut", "checkOutCutoff",
          "audience", "description", "notes", "requiresGeofence", "openAt", "checkInClosesAt", "closeAt",
          "checkOutClosesAt", "createdAt", "createdBy", "updatedAt"
        ])
        && data.keys().hasAll(["name", "type", "date", "location", "timeIn", "checkInCutoff", "timeOut", "checkOutCutoff", "audience", "description", "requiresGeofence", "openAt", "checkInClosesAt", "closeAt", "checkOutClosesAt"])
        && shortText(data.name, 160) && shortText(data.type, 60) && shortText(data.date, 10)
        && shortText(data.location, 240) && shortText(data.timeIn, 5) && shortText(data.checkInCutoff, 5)
        && shortText(data.timeOut, 5) && shortText(data.checkOutCutoff, 5)
        && data.audience in ["All students", "Section 1A", "Section 1B", "Section 2A", "Section 2B", "Section 3A", "Section 3B", "Section 4A", "Section 4B"]
        && shortText(data.description, 4000) && optionalShortText(data, "notes", 4000)
        && data.requiresGeofence is bool
        && data.openAt is timestamp && data.checkInClosesAt is timestamp && data.closeAt is timestamp && data.checkOutClosesAt is timestamp
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && optionalShortText(data, "createdBy", 128)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validStudent(data) {
      return data.keys().hasOnly([
          "uid", "accountId", "accountIdKey", "authEmail", "firstName", "middleName", "lastName", "birthday",
          "course", "section", "email", "phone", "photoDataUrl", "profilePhotoStorage", "profilePhotoDriveFileId", "profilePhotoDriveFileName", "profilePhotoUpdatedAt", "active", "role", "roleUpdatedAt",
          "roleUpdatedBy", "mustChangePassword", "createdAt", "updatedAt"
        ])
        && optionalShortText(data, "uid", 128) && optionalShortText(data, "accountId", 64)
        && optionalShortText(data, "accountIdKey", 64) && optionalShortText(data, "authEmail", 320)
        && optionalShortText(data, "firstName", 80) && optionalShortText(data, "middleName", 80)
        && optionalShortText(data, "lastName", 80) && optionalShortText(data, "birthday", 10)
        && optionalShortText(data, "course", 120) && optionalShortText(data, "email", 320)
        && optionalShortText(data, "phone", 24)
        // The bootstrap Super Admin account must never be represented as a student.
        && (!("email" in data) || !data.email.matches("(?i)^mikhailovna2007@gmail\\.com$"))
        && (!("authEmail" in data) || !data.authEmail.matches("(?i)^mikhailovna2007@gmail\\.com$"))
        && (!("photoDataUrl" in data) || (shortText(data.photoDataUrl, 350000) && data.photoDataUrl.matches('^data:image/(jpeg|png|webp);base64,.+$')))
        // Kept for existing records created before the Google Drive photo feature
        // was rolled back. Students cannot modify these fields from this version.
        && (!("profilePhotoStorage" in data) || data.profilePhotoStorage == "Google Drive")
        && optionalShortText(data, "profilePhotoDriveFileId", 160)
        && optionalShortText(data, "profilePhotoDriveFileName", 240)
        && (!("profilePhotoUpdatedAt" in data) || data.profilePhotoUpdatedAt is timestamp)
        && (!("section" in data) || data.section in ["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"])
        && (!("active" in data) || data.active is bool)
        && (!("role" in data) || data.role in ["head_admin", "attendance_admin", "student_manager", "student"])
        && (!("roleUpdatedAt" in data) || data.roleUpdatedAt is timestamp)
        && optionalShortText(data, "roleUpdatedBy", 128)
        && (!("mustChangePassword" in data) || data.mustChangePassword is bool)
        && (!("createdAt" in data) || data.createdAt is timestamp)
        && (!("updatedAt" in data) || data.updatedAt is timestamp);
    }

    function validFine(data) {
      return data.keys().hasOnly([
          "studentUid", "studentId", "studentName", "eventId", "eventName", "eventDate", "eventTimeIn",
          "eventTimeOut", "eventLocation", "serviceMinutes", "reason", "status", "assignmentHistory",
          "assignedAt", "assignedBy", "updatedAt", "updatedBy", "eventRemoved", "eventRemovedAt"
        ])
        && data.keys().hasAll(["studentUid", "studentId", "studentName", "serviceMinutes", "reason", "status", "assignmentHistory"])
        && shortText(data.studentUid, 128) && shortText(data.studentId, 64) && shortText(data.studentName, 200)
        && optionalShortText(data, "eventId", 128) && optionalShortText(data, "eventName", 160)
        && optionalShortText(data, "eventDate", 10) && optionalShortText(data, "eventTimeIn", 5)
        && optionalShortText(data, "eventTimeOut", 5) && optionalShortText(data, "eventLocation", 240)
        && data.serviceMinutes is number && data.serviceMinutes >= 1 && data.serviceMinutes <= 6000
        && shortText(data.reason, 2000) && data.status in ["Pending", "Completed"]
        && data.assignmentHistory is list && data.assignmentHistory.size() <= 50
        && (!("assignedAt" in data) || data.assignedAt is timestamp) && optionalShortText(data, "assignedBy", 128)
        && (!("updatedAt" in data) || data.updatedAt is timestamp) && optionalShortText(data, "updatedBy", 128)
        && (!("eventRemoved" in data) || data.eventRemoved is bool)
        && (!("eventRemovedAt" in data) || data.eventRemovedAt is timestamp);
    }

    function validNotification(data) {
      return data.keys().hasOnly([
          "recipientUid", "recipientRole", "category", "title", "message", "targetView", "studentName",
          "studentId", "section", "eventId", "reminderType", "read", "readAt", "createdAt"
        ])
        && data.keys().hasAll(["recipientUid", "recipientRole", "category", "title", "message", "targetView", "studentName", "studentId", "section", "read", "createdAt"])
        && shortText(data.recipientUid, 128) && shortText(data.recipientRole, 40)
        && data.category in ["attendance", "service", "face", "system"]
        && shortText(data.title, 160) && shortText(data.message, 2000) && shortText(data.targetView, 60)
        && shortText(data.studentName, 200) && shortText(data.studentId, 64) && shortText(data.section, 10)
        && optionalShortText(data, "eventId", 128) && optionalShortText(data, "reminderType", 30)
        && data.read is bool && (!("readAt" in data) || data.readAt is timestamp) && data.createdAt is timestamp;
    }

    function validLocation(location) {
      return location is map
        && location.keys().hasOnly(["latitude", "longitude", "accuracy", "distanceMeters"])
        && location.keys().hasAll(["latitude", "longitude", "distanceMeters"])
        && location.latitude is number && location.latitude >= -90 && location.latitude <= 90
        && location.longitude is number && location.longitude >= -180 && location.longitude <= 180
        && (!("accuracy" in location) || (location.accuracy is number && location.accuracy >= 0 && location.accuracy <= 100000))
        && location.distanceMeters is number && location.distanceMeters >= 0 && location.distanceMeters <= 20000000;
    }

    function validAttendance(data) {
      return data.keys().hasOnly([
          "studentUid", "studentId", "eventId", "eventName", "eventType", "eventDescription", "eventDate",
          "timeIn", "timeOut", "location", "audience", "checkInLocation", "checkOutLocation", "attendedAt", "arrivalStatus",
          "checkedInAt", "checkedOutAt", "status", "recordSource", "correctionId", "correctedBy", "correctedAt", "correctionReason"
        ])
        && data.keys().hasAll(["studentUid", "studentId", "eventId", "eventName", "eventType", "eventDescription", "eventDate", "timeIn", "timeOut", "location", "audience", "attendedAt", "checkedInAt", "status"])
        && shortText(data.studentUid, 128) && shortText(data.studentId, 64) && shortText(data.eventId, 128)
        && shortText(data.eventName, 160) && shortText(data.eventType, 60) && shortText(data.eventDescription, 4000)
        && shortText(data.eventDate, 10) && shortText(data.timeIn, 5) && shortText(data.timeOut, 5)
        && shortText(data.location, 240) && shortText(data.audience, 30)
        && (!("checkInLocation" in data) || validLocation(data.checkInLocation))
        && (!("checkOutLocation" in data) || validLocation(data.checkOutLocation))
        && data.attendedAt is timestamp && data.checkedInAt is timestamp
        && (!("checkedOutAt" in data) || data.checkedOutAt is timestamp)
        && (!("arrivalStatus" in data) || data.arrivalStatus in ["present", "late"])
        && data.status in ["checked-in", "completed"];
    }

    // Spark-plan attendance verification. Rules enforce authorization and data
    // integrity. Exact geofence distance is calculated by the client: Rules
    // cannot do trigonometry, and the previous coordinate-square approximation
    // rejected valid locations inside the configured circle.
    function attendanceMatchesEvent(data, event) {
      return data.eventName == event.name
        && data.eventType == event.type
        && data.eventDescription == event.description
        && data.eventDate == event.date
        && data.timeIn == event.timeIn
        && data.timeOut == event.timeOut
        && data.location == event.location
        && data.audience == event.audience;
    }

    function withinSparkGeofence(data, eventId, event) {
      return event.requiresGeofence != true || (
        exists(/databases/$(database)/documents/eventGeofences/$(eventId))
        && get(/databases/$(database)/documents/eventGeofences/$(eventId)).data.enabled == true
        && data.keys().hasAll(["checkInLocation"])
        && validLocation(data.checkInLocation)
      );
    }

    function studentCanReadEventGeofence(eventId) {
      return isStudent()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && (get(/databases/$(database)/documents/events/$(eventId)).data.audience == "All students"
          || get(/databases/$(database)/documents/events/$(eventId)).data.audience == "Section " + get(/databases/$(database)/documents/students/$(request.auth.uid)).data.section);
    }

    function studentCanCheckIn(attendanceId, data) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      let student = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return isStudent()
        && attendanceId == request.auth.uid + "_" + data.eventId
        && exists(/databases/$(database)/documents/events/$(data.eventId))
        && exists(/databases/$(database)/documents/faceRegistrations/$(request.auth.uid))
        && get(/databases/$(database)/documents/faceRegistrations/$(request.auth.uid)).data.registered == true
        && data.studentUid == request.auth.uid
        && data.studentId == student.accountId
        && attendanceMatchesEvent(data, event)
        && (event.audience == "All students" || event.audience == "Section " + student.section)
        && request.time >= event.openAt && request.time < event.closeAt
        && data.attendedAt == request.time && data.checkedInAt == request.time
        && data.keys().hasAll(["arrivalStatus"])
        && ((request.time <= event.checkInClosesAt && data.arrivalStatus == "present")
          || (request.time > event.checkInClosesAt && data.arrivalStatus == "late"))
        && data.status == "checked-in"
        && !data.keys().hasAny(["recordSource", "correctionId", "correctedBy", "correctedAt", "correctionReason"])
        && !data.keys().hasAny(["checkedOutAt", "checkOutLocation"])
        && withinSparkGeofence(data, data.eventId, event);
    }

    function studentCanCheckOut(data, previous) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      return isStudent()
        && previous.studentUid == request.auth.uid
        && data.studentUid == request.auth.uid
        && previous.status == "checked-in" && data.status == "completed"
        && data.checkedOutAt == request.time
        && request.time >= event.closeAt && request.time <= event.checkOutClosesAt
        && data.diff(previous).affectedKeys().hasOnly(["checkOutLocation", "checkedOutAt", "status"])
        && (event.requiresGeofence != true || data.keys().hasAll(["checkOutLocation"]))
        && (!event.requiresGeofence || withinSparkGeofence({ "checkInLocation": data.checkOutLocation }, data.eventId, event));
    }

    // A correction and its immutable before/after audit must be committed together.
    function validAdminCorrection(attendanceId, data, before) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      let student = get(/databases/$(database)/documents/students/$(data.studentUid)).data;
      let audit = getAfter(/databases/$(database)/documents/attendance/$(attendanceId)/corrections/$(data.correctionId)).data;
      return canManageAttendance() && validAttendance(data)
        && attendanceId == data.studentUid + "_" + data.eventId
        && student.active == true && data.studentId == student.accountId
        && (event.audience == "All students" || event.audience == "Section " + student.section)
        && attendanceMatchesEvent(data, event)
        && data.recordSource == "admin-corrected" && data.correctedBy == request.auth.uid
        && shortText(data.correctionId, 128) && data.correctionId.matches('^[A-Za-z0-9_-]+$')
        && data.correctedAt == request.time
        && shortText(data.correctionReason, 1000) && data.correctionReason.size() >= 5
        && data.attendedAt == data.checkedInAt && data.checkedInAt <= request.time
        && ((data.status == "completed" && data.checkedOutAt >= data.checkedInAt && data.checkedOutAt <= request.time)
          || (data.status == "checked-in" && !data.keys().hasAny(["checkedOutAt", "checkOutLocation"])))
        && data.keys().hasAll(["arrivalStatus"])
        && audit.keys().hasOnly(["before", "after", "by", "at", "reason"])
        && audit.before == before && audit.after == data
        && audit.by == request.auth.uid && audit.at == request.time && audit.reason == data.correctionReason;
    }

    match /students/{studentUid} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.uid == studentUid && resource.data.active == true);
      allow list: if isAdmin();
      allow create: if canManageStudents()
        && validStudent(request.resource.data)
        && !request.resource.data.keys().hasAny(["role", "roleUpdatedAt", "roleUpdatedBy"]);
      allow delete: if isSuperAdmin();
      allow update: if (isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "roleUpdatedAt", "roleUpdatedBy"])
          && request.resource.data.role in ["head_admin", "attendance_admin", "student_manager", "student"]
          && request.resource.data.roleUpdatedAt is timestamp
          && request.resource.data.roleUpdatedBy == request.auth.uid)
        || (canManageStudents()
          && validStudent(request.resource.data)
          && (!isStudentManager() || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "accountId", "accountIdKey", "firstName", "middleName", "lastName", "birthday", "course", "section", "email", "phone", "photoDataUrl", "updatedAt", "grade", "adviser"
          ]))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "roleUpdatedAt", "roleUpdatedBy"]))
        || (isStudent()
          && request.auth.uid == studentUid
          && validStudent(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "accountId", "accountIdKey", "firstName", "middleName", "lastName", "birthday", "course", "section", "email", "phone", "photoDataUrl", "updatedAt"
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && (!("photoDataUrl" in request.resource.data)
            || (request.resource.data.photoDataUrl is string
              && request.resource.data.photoDataUrl.size() <= 350000))
          && request.resource.data.section in ["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"])
        || (isStudent()
          && request.auth.uid == studentUid
          && resource.data.mustChangePassword == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword", "updatedAt"])
          && request.resource.data.updatedAt is timestamp);
    }

    match /adminProfiles/{adminUid} {
      allow read, create, update: if isSuperAdmin() && request.auth.uid == adminUid;
      allow delete: if false;
    }

    // Normalized Student IDs are used as document names. A duplicate write is
    // an update, and updates are denied, so the same ID cannot be registered twice.
    match /studentIds/{studentIdKey} {
      allow read: if signedIn();
      allow create: if (canManageStudents() || signedIn())
        && !exists(/databases/$(database)/documents/studentIds/$(studentIdKey))
        && (canManageStudents() || request.resource.data.uid == request.auth.uid);
      allow update: if false;
      allow delete: if canManageStudents() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /events/{eventId} {
      // Students cannot read legacy events that embed geofence coordinates.
      allow read: if isSuperAdmin() || isHeadAdmin() || isAttendanceAdmin() || isStudentManager()
        || (isStudent() && !resource.data.keys().hasAll(["geofence"]));
      allow create, update: if canManageAttendance()
        && validEvent(request.resource.data)
        && request.resource.data.openAt is timestamp
        && request.resource.data.checkInClosesAt is timestamp
        && request.resource.data.closeAt is timestamp
        && request.resource.data.checkOutClosesAt is timestamp
        && request.resource.data.openAt < request.resource.data.checkInClosesAt
        && request.resource.data.checkInClosesAt <= request.resource.data.closeAt
        && request.resource.data.closeAt < request.resource.data.checkOutClosesAt;
      // Deletion is deliberately stricter than event editing. This protects
      // the operational-data reset from being triggered by other admin roles.
      allow delete: if isSuperAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if canViewAttendanceReports()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if (canManageAttendance()
          && request.resource.data.keys().hasAll(["correctionId", "recordSource", "correctedBy", "correctedAt", "correctionReason"])
          && validAdminCorrection(attendanceId, request.resource.data, null))
        || (validAttendance(request.resource.data) && studentCanCheckIn(attendanceId, request.resource.data));
      allow update: if (canManageAttendance()
          && request.resource.data.keys().hasAll(["correctionId", "recordSource", "correctedBy", "correctedAt", "correctionReason"])
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.eventId == resource.data.eventId
          && validAdminCorrection(attendanceId, request.resource.data, resource.data))
        || (canManageAttendance() && validAttendance(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["eventName", "eventType", "eventDescription", "eventDate", "timeIn", "timeOut", "location", "audience"])
          && attendanceMatchesEvent(request.resource.data, get(/databases/$(database)/documents/events/$(resource.data.eventId)).data))
        || (validAttendance(request.resource.data) && studentCanCheckOut(request.resource.data, resource.data));
      allow delete: if isSuperAdmin();

      match /corrections/{correctionId} {
        allow read: if canViewAttendanceReports()
          || (isStudent() && get(/databases/$(database)/documents/attendance/$(attendanceId)).data.studentUid == request.auth.uid);
        allow create: if canManageAttendance()
          && request.resource.data.after.correctionId == correctionId
          && request.resource.data.after == getAfter(/databases/$(database)/documents/attendance/$(attendanceId)).data
          && validAdminCorrection(attendanceId, request.resource.data.after,
            exists(/databases/$(database)/documents/attendance/$(attendanceId)) ? get(/databases/$(database)/documents/attendance/$(attendanceId)).data : null);
        allow update, delete: if false;
      }
    }

    match /fines/{fineId} {
      allow read: if canViewFines()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if canManageFines() && validFine(request.resource.data);
      allow update: if canManageFines() && validFine(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /dismissedHistory/{dismissalId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow delete: if isSuperAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid;
      allow update: if false;
    }

    match /faceRegistrations/{studentUid} {
      allow read: if isAdmin() || (isStudent() && request.auth.uid == studentUid);
      allow create, update: if isStudent()
        && request.auth.uid == studentUid
        && request.resource.data.registered == true;
      allow delete: if canManageStudents();
    }

    match /eventGeofences/{eventId} {
      // Eligible students need a single geofence document to calculate the
      // exact client-side distance. Listing all attendance areas stays denied.
      allow get: if canManageAttendance() || studentCanReadEventGeofence(eventId);
      allow list: if canManageAttendance();
      allow create, update: if canManageAttendance() && validGeofence(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      // Notifications belong to one account. Roles determine who receives a
      // notification, not who can read a shared administrator inbox.
      allow read, delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && validNotification(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"]);
      allow create: if (canManageAttendance() || canManageStudents())
          && validNotification(request.resource.data)
        || (isStudent()
          && validNotification(request.resource.data)
          && request.resource.data.category == "face"
          && request.resource.data.recipientUid == request.auth.uid
          && request.resource.data.recipientRole == "");
    }

    match /presence/{studentUid} {
      allow read: if isAdmin()
        || (isStudent() && request.auth.uid == studentUid);
      allow create, update: if isStudent()
        && request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly(["online", "status", "lastSeen", "offlineAt"])
        && request.resource.data.online is bool
        && request.resource.data.status in ["online", "offline", "logged-out"]
        && request.resource.data.lastSeen is timestamp
        && (!("offlineAt" in request.resource.data)
          || request.resource.data.offlineAt is timestamp);
      allow delete: if isSuperAdmin();
    }

    match /presenceSessions/{sessionId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.keys().hasOnly(["studentUid", "sessionId", "online", "status", "lastSeen", "offlineAt"])
        && request.resource.data.online is bool
        && request.resource.data.status in ["online", "offline", "logged-out"]
        && request.resource.data.lastSeen is timestamp
        && (!("offlineAt" in request.resource.data)
          || request.resource.data.offlineAt is timestamp);
      allow update: if isStudent()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.keys().hasOnly(["studentUid", "sessionId", "online", "status", "lastSeen", "offlineAt"])
        && request.resource.data.online is bool
        && request.resource.data.status in ["online", "offline", "logged-out"]
        && request.resource.data.lastSeen is timestamp
        && (!("offlineAt" in request.resource.data)
          || request.resource.data.offlineAt is timestamp);
      allow delete: if isSuperAdmin();
    }

    match /auditLogs/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
