rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSuperAdmin() || isHeadAdmin() || isAttendanceAdmin() || isStudentManager();
    }

    // The bootstrap email is the protected Super Admin account. Other roles are kept
    // on each user's student profile so this works without Cloud Functions.
    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.uid == "8uEjAk72BLWKjvnQJEatBdeVAi02"
          || request.auth.token.email == "mikhailovna2007@gmail.com"
        );
    }

    function hasStoredRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.keys().hasAll(["role"])
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == role;
    }

    function isHeadAdmin() {
      return hasStoredRole("head_admin");
    }

    function isAttendanceAdmin() {
      return hasStoredRole("attendance_admin");
    }

    function isStudentManager() {
      return hasStoredRole("student_manager");
    }

    function canManageStudents() {
      return isSuperAdmin() || isHeadAdmin() || isStudentManager();
    }

    function canManageAttendance() {
      return isSuperAdmin() || (signedIn() && hasAttendanceManagementRole());
    }
    function hasAttendanceManagementRole() {
      let profile = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return profile.active == true
        && profile.get("role", "student") in ["head_admin", "attendance_admin"];
    }

    function canViewAttendanceReports() {
      return isSuperAdmin() || isHeadAdmin() || isAttendanceAdmin() || isStudentManager();
    }

    function canViewFines() {
      return isSuperAdmin() || isHeadAdmin() || isStudentManager();
    }

    function canManageFines() {
      return isSuperAdmin() || isHeadAdmin();
    }

    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get("passwordResetRequired", false) == false
        && (!("passwordResetValidAfter" in get(/databases/$(database)/documents/students/$(request.auth.uid)).data)
          || request.auth.token.auth_time > get(/databases/$(database)/documents/students/$(request.auth.uid)).data.passwordResetValidAfter);
    }

    function shortText(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function optionalShortText(data, key, maximum) {
      return !(key in data) || shortText(data[key], maximum);
    }

    function validBoundaryPoint(point) {
      return point is map && point.keys().hasOnly(["latitude", "longitude"])
        && point.keys().hasAll(["latitude", "longitude"])
        && point.latitude is number && point.latitude >= -85 && point.latitude <= 85
        && point.longitude is number && point.longitude >= -180 && point.longitude <= 180;
    }

    function validBoundaryVertices(points) {
      return points is list && points.size() >= 3 && points.size() <= 10
        && validBoundaryPoint(points[0]) && validBoundaryPoint(points[1]) && validBoundaryPoint(points[2])
        && (points.size() < 4 || validBoundaryPoint(points[3]))
        && (points.size() < 5 || validBoundaryPoint(points[4]))
        && (points.size() < 6 || validBoundaryPoint(points[5]))
        && (points.size() < 7 || validBoundaryPoint(points[6]))
        && (points.size() < 8 || validBoundaryPoint(points[7]))
        && (points.size() < 9 || validBoundaryPoint(points[8]))
        && (points.size() < 10 || validBoundaryPoint(points[9]));
    }

    function validGeofence(geofence) {
      return geofence is map
        && geofence.keys().hasOnly(["enabled", "type", "vertices", "latitude", "longitude", "radiusMeters", "address"])
        && geofence.keys().hasAll(["enabled"])
        && geofence.enabled is bool
        && optionalShortText(geofence, "address", 500)
        && (!("type" in geofence) || geofence.type in ["circle", "polygon"])
        && (!geofence.enabled || (("type" in geofence && geofence.type == "polygon") ? (
          geofence.keys().hasAll(["vertices"]) && validBoundaryVertices(geofence.vertices)
          && !geofence.keys().hasAny(["latitude", "longitude", "radiusMeters"])
        ) : (
          geofence.keys().hasAll(["latitude", "longitude", "radiusMeters"])
          && geofence.latitude is number && geofence.latitude >= -90 && geofence.latitude <= 90
          && geofence.longitude is number && geofence.longitude >= -180 && geofence.longitude <= 180
          && geofence.radiusMeters is number && geofence.radiusMeters > 0 && geofence.radiusMeters <= 100000
          && !("vertices" in geofence)
        )));
    }

    function eventSections(event) {
      return ("audienceSections" in event)
        ? (event.audienceSections.size() == 0 ? ["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"] : event.audienceSections)
        : (event.audience == "All students" ? ["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"]
          : event.audience == "Section 1A" ? ["1A"] : event.audience == "Section 1B" ? ["1B"]
          : event.audience == "Section 2A" ? ["2A"] : event.audience == "Section 2B" ? ["2B"]
          : event.audience == "Section 3A" ? ["3A"] : event.audience == "Section 3B" ? ["3B"]
          : event.audience == "Section 4A" ? ["4A"] : ["4B"]);
    }
    function validSectionTimes(times) {
      let current = request.time;
      let a = times.get("1A", current);
      let b = times.get("1B", current);
      let c = times.get("2A", current);
      let d = times.get("2B", current);
      let e = times.get("3A", current);
      let f = times.get("3B", current);
      let g = times.get("4A", current);
      let h = times.get("4B", current);
      return a is timestamp && a <= current && b is timestamp && b <= current
        && c is timestamp && c <= current && d is timestamp && d <= current
        && e is timestamp && e <= current && f is timestamp && f <= current
        && g is timestamp && g <= current && h is timestamp && h <= current;
    }
    function validEventAudience(data) {
      let sections = eventSections(data);
      return !data.keys().hasAny(["audienceSections", "sectionAssignedAt", "rosterVersion"])
        ? data.audience != "Selected sections"
        : (data.keys().hasAll(["audienceSections", "sectionAssignedAt", "rosterVersion", "attendanceRoster", "rosterCapturedAt"])
          && data.audienceSections is list && data.audienceSections.size() <= 8
          && data.audienceSections.hasOnly(["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"])
          && data.audienceSections.toSet().size() == data.audienceSections.size()
          && ((data.audienceSections.size() == 0 && data.audience == "All students")
            || (data.audienceSections.size() == 1 && data.audience == "Section " + data.audienceSections[0])
            || (data.audienceSections.size() > 1 && data.audience == "Selected sections"))
          && data.sectionAssignedAt is map && data.sectionAssignedAt.keys().hasOnly(sections)
          && data.sectionAssignedAt.keys().hasAll(sections) && validSectionTimes(data.sectionAssignedAt)
          && data.rosterVersion is int && data.rosterVersion > 0);
    }
    function validRosterUpdate(data, before) {
      return !data.diff(before).affectedKeys().hasAny(["audience", "audienceSections", "sectionAssignedAt", "rosterVersion", "attendanceRoster", "rosterCapturedAt"])
        || (!('checkoutOnlyReopened' in before) && (("audienceSections" in data)
          ? (before.checkOutClosesAt > request.time && data.rosterCapturedAt == request.time
            && data.rosterVersion == (("rosterVersion" in before) ? before.rosterVersion + 1 : 1))
          : (before.openAt > request.time && data.keys().hasAll(["attendanceRoster", "rosterCapturedAt"]) && data.rosterCapturedAt == request.time)));
    }
    function validEvent(data) {
      return data.keys().hasOnly([
          "name", "type", "date", "location", "timeIn", "checkInCutoff", "checkInClose", "timeOut", "checkOutCutoff",
          "audience", "description", "notes", "requiresGeofence", "openAt", "checkInClosesAt", "closeAt",
          "lateAfterAt", "checkOutClosesAt", "checkoutOnlyReopened", "createdAt", "createdBy", "updatedAt", "attendanceRoster", "rosterCapturedAt", "hasSurvey", "surveyArchived", "audienceSections", "sectionAssignedAt", "rosterVersion", "sessionPeriod", "sessionGroupId", "sessionBaseName"
        ])
        // Every required field is read and type-checked below. Missing fields
        // therefore deny the write without a duplicate required-key scan.
        && shortText(data.name, 160) && shortText(data.type, 60) && shortText(data.date, 10)
        && shortText(data.location, 240) && shortText(data.timeIn, 5) && shortText(data.checkInCutoff, 5) && optionalShortText(data, "checkInClose", 5)
        && shortText(data.timeOut, 5) && shortText(data.checkOutCutoff, 5)
        && data.audience in ["All students", "Selected sections", "Section 1A", "Section 1B", "Section 2A", "Section 2B", "Section 3A", "Section 3B", "Section 4A", "Section 4B"]
        && validEventAudience(data)
        && shortText(data.description, 4000) && optionalShortText(data, "notes", 4000)
        && data.requiresGeofence is bool
        && (!("hasSurvey" in data) || data.hasSurvey is bool)
        && (!("surveyArchived" in data) || data.surveyArchived is bool)
        && (("attendanceRoster" in data) == ("rosterCapturedAt" in data))
        && (!("attendanceRoster" in data) || (data.attendanceRoster is map
          && data.attendanceRoster.keys().size() <= 5000 && data.rosterCapturedAt is timestamp))
        && data.openAt is timestamp && (!('lateAfterAt' in data) || data.lateAfterAt is timestamp) && data.checkInClosesAt is timestamp && data.closeAt is timestamp && data.checkOutClosesAt is timestamp
        && (!('checkoutOnlyReopened' in data) || data.checkoutOnlyReopened == true)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && optionalShortText(data, "createdBy", 128)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validCheckoutExtension(data, before) {
      return data.checkoutOnlyReopened == true
        && !data.diff(before).affectedKeys().hasAny([
          "date", "timeIn", "checkInCutoff", "timeOut", "openAt", "checkInClosesAt", "closeAt", "lateAfterAt", "checkInClose"])
        && (data.checkOutClosesAt > before.checkOutClosesAt && data.checkOutClosesAt > request.time
          || ('checkoutOnlyReopened' in before && data.checkOutClosesAt == before.checkOutClosesAt && data.checkOutCutoff == before.checkOutCutoff));
    }
    function validScheduleEdit(data, before) {
      return (before.openAt > request.time || data.date == before.date)
        && ('checkoutOnlyReopened' in before ? validCheckoutExtension(data, before)
          : before.checkOutClosesAt > request.time ? !('checkoutOnlyReopened' in data)
          : ('checkoutOnlyReopened' in data ? validCheckoutExtension(data, before)
            : !data.diff(before).affectedKeys().hasAny([
              "date", "timeIn", "checkInCutoff", "timeOut", "checkOutCutoff", "openAt", "checkInClosesAt", "closeAt", "checkOutClosesAt", "lateAfterAt", "checkInClose"])));
    }
    function validSession(data, eventId) {
      // This helper is used only by the event write rule; resource already
      // contains this document, so avoid duplicate exists/get expressions.
      let existing = request.method == 'update';
      let before = existing ? resource.data : data;
      let fields = ["sessionPeriod", "sessionGroupId", "sessionBaseName"];
      let hasSession = data.keys().hasAny(fields);
      return ((!existing && !('checkoutOnlyReopened' in data)) || (existing && validScheduleEdit(data, before)
          && (!before.keys().hasAny(fields) || (hasSession && data.sessionGroupId == before.sessionGroupId
            && (data.sessionPeriod == before.sessionPeriod || (before.openAt > request.time && before.sessionGroupId == eventId))))))
        && (!hasSession || (data.keys().hasAll(fields)
          && data.sessionPeriod in ["morning", "afternoon"]
          && shortText(data.sessionBaseName, 145)
          && shortText(data.sessionGroupId, 128) && data.sessionGroupId.matches('^[A-Za-z0-9_-]+$')
          && (data.sessionPeriod == "morning"
            ? (data.sessionGroupId == eventId
              && (!exists(/databases/$(database)/documents/events/$(eventId + '_afternoon'))
                || (getAfter(/databases/$(database)/documents/events/$(eventId + '_afternoon')).data.date == data.date
                  && data.checkOutClosesAt <= getAfter(/databases/$(database)/documents/events/$(eventId + '_afternoon')).data.openAt)))
            : (data.sessionGroupId == eventId
              ? !exists(/databases/$(database)/documents/events/$(eventId + '_afternoon'))
              : (eventId == data.sessionGroupId + '_afternoon'
              && (existing || data.openAt > request.time)
              && getAfter(/databases/$(database)/documents/events/$(data.sessionGroupId)).data.sessionPeriod == "morning"
              && getAfter(/databases/$(database)/documents/events/$(data.sessionGroupId)).data.date == data.date
              && getAfter(/databases/$(database)/documents/events/$(data.sessionGroupId)).data.checkOutClosesAt <= data.openAt)))));
    }

    function validStudent(data) {
      return data.keys().hasOnly([
          "uid", "accountId", "accountIdKey", "authEmail", "firstName", "middleName", "lastName", "birthday", "gender",
          "course", "section", "email", "phone", "photoDataUrl", "profilePhotoStorage", "profilePhotoDriveFileId", "profilePhotoDriveFileName", "profilePhotoUpdatedAt", "active", "role", "roleUpdatedAt",
          "roleUpdatedBy", "mustChangePassword", "passwordResetRequired", "passwordResetValidAfter", "createdAt", "updatedAt"
        ])
        && optionalShortText(data, "uid", 128) && optionalShortText(data, "accountId", 64)
        && optionalShortText(data, "accountIdKey", 64) && optionalShortText(data, "authEmail", 320)
        && optionalShortText(data, "firstName", 80) && optionalShortText(data, "middleName", 80)
        && optionalShortText(data, "lastName", 80) && optionalShortText(data, "birthday", 10)
        && (!("gender" in data) || data.gender in ["", "Male", "Female"])
        && optionalShortText(data, "course", 120) && optionalShortText(data, "email", 320)
        && optionalShortText(data, "phone", 24)
        // The bootstrap Super Admin account must never be represented as a student.
        && (!("email" in data) || !data.email.matches("(?i)^mikhailovna2007@gmail\\.com$"))
        && (!("authEmail" in data) || !data.authEmail.matches("(?i)^mikhailovna2007@gmail\\.com$"))
        && (!("photoDataUrl" in data) || (shortText(data.photoDataUrl, 350000) && data.photoDataUrl.matches('^data:image/(jpeg|png|webp);base64,.+$')))
        // Kept for existing records created before the Google Drive photo feature
        // was rolled back. Students cannot modify these fields from this version.
        && (!("profilePhotoStorage" in data) || data.profilePhotoStorage == "Google Drive")
        && optionalShortText(data, "profilePhotoDriveFileId", 160)
        && optionalShortText(data, "profilePhotoDriveFileName", 240)
        && (!("profilePhotoUpdatedAt" in data) || data.profilePhotoUpdatedAt is timestamp)
        && (!("section" in data) || data.section in ["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"])
        && (!("active" in data) || data.active is bool)
        && (!("role" in data) || data.role in ["head_admin", "attendance_admin", "student_manager", "student"])
        && (!("roleUpdatedAt" in data) || data.roleUpdatedAt is timestamp)
        && optionalShortText(data, "roleUpdatedBy", 128)
        && (!("mustChangePassword" in data) || data.mustChangePassword is bool)
        && (!("passwordResetRequired" in data) || data.passwordResetRequired is bool)
        && (!("passwordResetValidAfter" in data) || (data.passwordResetValidAfter is int && data.passwordResetValidAfter >= 0))
        && (!("createdAt" in data) || data.createdAt is timestamp)
        && (!("updatedAt" in data) || data.updatedAt is timestamp);
    }

    function approvedRegistration(accountIdKey, uid) {
      return signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/registrationRequests/$(accountIdKey))
        && get(/databases/$(database)/documents/registrationRequests/$(accountIdKey)).data.uid == uid
        && get(/databases/$(database)/documents/registrationRequests/$(accountIdKey)).data.status == "approved";
    }

    function validRegistrationRequest(data, requestId) {
      return data.keys().hasOnly(["uid", "accountId", "accountIdKey", "birthday", "firstName", "lastName", "gender", "course", "section", "status", "requestedAt", "updatedAt", "reviewedAt", "reviewedBy"])
        && data.keys().hasAll(["uid", "accountId", "accountIdKey", "birthday", "firstName", "lastName", "course", "section", "status", "requestedAt", "updatedAt"])
        && request.auth.uid == data.uid && requestId == data.accountIdKey
        && shortText(data.accountId, 64) && shortText(data.accountIdKey, 64) && shortText(data.birthday, 10)
        && shortText(data.firstName, 80) && shortText(data.lastName, 80) && shortText(data.course, 120)
        && (!("gender" in data) || data.gender in ["", "Male", "Female"])
        && data.section in ["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"]
        && data.status == "pending" && data.requestedAt == request.time && data.updatedAt == request.time;
    }

    function validRegistrationReapplication(data) {
      return signedIn() && resource.data.uid == request.auth.uid && resource.data.status == "declined"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["birthday", "firstName", "lastName", "gender", "course", "section", "status", "updatedAt"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.accountIdKey == resource.data.accountIdKey
        && shortText(request.resource.data.birthday, 10)
        && shortText(request.resource.data.firstName, 80) && shortText(request.resource.data.lastName, 80)
        && (!("gender" in data) || data.gender in ["", "Male", "Female"])
        && shortText(request.resource.data.course, 120)
        && request.resource.data.section in ["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"]
        && request.resource.data.status == "pending" && request.resource.data.updatedAt == request.time;
    }

    function validFine(data) {
      return data.keys().hasOnly([
          "studentUid", "studentId", "studentName", "eventId", "eventName", "eventDate", "eventTimeIn",
          "eventTimeOut", "eventLocation", "serviceMinutes", "reason", "status", "assignmentHistory",
          "assignedAt", "assignedBy", "updatedAt", "updatedBy", "eventRemoved", "eventRemovedAt"
        ])
        && data.keys().hasAll(["studentUid", "studentId", "studentName", "serviceMinutes", "reason", "status", "assignmentHistory"])
        && shortText(data.studentUid, 128) && shortText(data.studentId, 64) && shortText(data.studentName, 200)
        && optionalShortText(data, "eventId", 128) && optionalShortText(data, "eventName", 160)
        && optionalShortText(data, "eventDate", 10) && optionalShortText(data, "eventTimeIn", 5)
        && optionalShortText(data, "eventTimeOut", 5) && optionalShortText(data, "eventLocation", 240)
        && data.serviceMinutes is number && data.serviceMinutes >= 1 && data.serviceMinutes <= 6000
        && shortText(data.reason, 2000) && data.status in ["Pending", "Completed"]
        && data.assignmentHistory is list && data.assignmentHistory.size() <= 50
        && (!("assignedAt" in data) || data.assignedAt is timestamp) && optionalShortText(data, "assignedBy", 128)
        && (!("updatedAt" in data) || data.updatedAt is timestamp) && optionalShortText(data, "updatedBy", 128)
        && (!("eventRemoved" in data) || data.eventRemoved is bool)
        && (!("eventRemovedAt" in data) || data.eventRemovedAt is timestamp);
    }

    function validNotification(data) {
      return data.keys().hasOnly([
          "recipientUid", "recipientRole", "category", "title", "message", "targetView", "studentName",
          "studentId", "section", "eventId", "reminderType", "read", "readAt", "createdAt"
        ])
        && data.keys().hasAll(["recipientUid", "recipientRole", "category", "title", "message", "targetView", "studentName", "studentId", "section", "read", "createdAt"])
        && shortText(data.recipientUid, 128) && shortText(data.recipientRole, 40)
        && data.category in ["attendance", "service", "face", "system"]
        && shortText(data.title, 160) && shortText(data.message, 2000) && shortText(data.targetView, 60)
        && shortText(data.studentName, 200) && shortText(data.studentId, 64) && shortText(data.section, 10)
        && optionalShortText(data, "eventId", 128) && optionalShortText(data, "reminderType", 30)
        && data.read is bool && (!("readAt" in data) || data.readAt is timestamp) && data.createdAt is timestamp;
    }

    function validLocation(location) {
      return location is map
        && location.keys().hasOnly(["latitude", "longitude", "accuracy", "distanceMeters"])
        && location.keys().hasAll(["latitude", "longitude", "distanceMeters"])
        && location.latitude is number && location.latitude >= -90 && location.latitude <= 90
        && location.longitude is number && location.longitude >= -180 && location.longitude <= 180
        && (!("accuracy" in location) || (location.accuracy is number && location.accuracy >= 0 && location.accuracy <= 100000))
        && location.distanceMeters is number && location.distanceMeters >= 0 && location.distanceMeters <= 20000000;
    }

    function validAttendance(data) {
      return data.keys().hasOnly([
          "studentUid", "studentId", "eventId", "eventName", "eventType", "eventDescription", "eventDate",
          "timeIn", "timeOut", "location", "audience", "checkInLocation", "checkOutLocation", "attendedAt", "arrivalStatus",
          "checkedInAt", "checkedOutAt", "status", "recordSource", "correctionId", "correctedBy", "correctedAt", "correctionReason"
        ])
        && data.keys().hasAll(["studentUid", "studentId", "eventId", "eventName", "eventType", "eventDescription", "eventDate", "timeIn", "timeOut", "location", "audience", "status"])
        && shortText(data.studentUid, 128) && shortText(data.studentId, 64) && shortText(data.eventId, 128)
        && shortText(data.eventName, 160) && shortText(data.eventType, 60) && shortText(data.eventDescription, 4000)
        && shortText(data.eventDate, 10) && shortText(data.timeIn, 5) && shortText(data.timeOut, 5)
        && shortText(data.location, 240) && shortText(data.audience, 30)
        && (!("checkInLocation" in data) || validLocation(data.checkInLocation))
        && (!("checkOutLocation" in data) || validLocation(data.checkOutLocation))
        && (!("checkedOutAt" in data) || data.checkedOutAt is timestamp)
        && ((data.keys().hasAll(["attendedAt", "checkedInAt", "arrivalStatus"])
          && data.attendedAt is timestamp && data.checkedInAt is timestamp
          && data.arrivalStatus in ["present", "late"]
          && data.status in ["checked-in", "completed"])
          || (data.status == "checkout-only" && data.arrivalStatus == "absent"
            && data.keys().hasAll(["checkedOutAt"])
            && !data.keys().hasAny(["attendedAt", "checkedInAt", "checkInLocation"])));
    }

    // Spark-plan attendance verification. Rules enforce authorization and data
    // integrity. Exact geofence distance is calculated by the client: Rules
    // cannot do trigonometry, and the previous coordinate-square approximation
    // rejected valid locations inside the configured circle.
    function attendanceMatchesEvent(data, event) {
      return data.eventName == event.name
        && data.eventType == event.type
        && data.eventDescription == event.description
        && data.eventDate == event.date
        && data.timeIn == event.timeIn
        && data.timeOut == event.timeOut
        && data.location == event.location
        && data.audience == event.audience;
    }

    function withinSparkGeofence(data, eventId, event) {
      return event.requiresGeofence != true || (
        exists(/databases/$(database)/documents/eventGeofences/$(eventId))
        && get(/databases/$(database)/documents/eventGeofences/$(eventId)).data.enabled == true
        && data.keys().hasAll(["checkInLocation"])
        && validLocation(data.checkInLocation)
      );
    }

    function studentCanReadEventGeofence(eventId) {
      return isStudent()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && (eligibleForAttendance(get(/databases/$(database)/documents/events/$(eventId)).data,
          get(/databases/$(database)/documents/students/$(request.auth.uid)).data, request.auth.uid)
          || (exists(/databases/$(database)/documents/attendance/$(request.auth.uid + "_" + eventId))
            && get(/databases/$(database)/documents/attendance/$(request.auth.uid + "_" + eventId)).data.studentUid == request.auth.uid
            && get(/databases/$(database)/documents/attendance/$(request.auth.uid + "_" + eventId)).data.status == "checked-in"));
    }

    function eligibleForAttendance(event, student, uid) {
      return ("attendanceRoster" in event)
        ? ((uid in event.attendanceRoster && (!("audienceSections" in event) || event.attendanceRoster[uid] in eventSections(event))) || (
          student.active == true
          && student.createdAt is timestamp
          && event.rosterCapturedAt is timestamp
          && student.createdAt >= event.rosterCapturedAt
          && student.section in eventSections(event)
        ))
        : student.section in eventSections(event);
    }

    function studentCanCheckIn(attendanceId, data) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      let student = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return isStudent()
        && !('checkoutOnlyReopened' in event)
        && attendanceId == request.auth.uid + "_" + data.eventId
        && exists(/databases/$(database)/documents/events/$(data.eventId))
        && exists(/databases/$(database)/documents/faceRegistrations/$(request.auth.uid))
        && get(/databases/$(database)/documents/faceRegistrations/$(request.auth.uid)).data.registered == true
        && data.studentUid == request.auth.uid
        && data.studentId == student.accountId
        && attendanceMatchesEvent(data, event)
        && eligibleForAttendance(event, student, request.auth.uid)
        && request.time >= event.openAt && request.time <= event.checkOutClosesAt
        && data.attendedAt == request.time && data.checkedInAt == request.time
        && data.keys().hasAll(["arrivalStatus"])
        && ((request.time < (("lateAfterAt" in event) ? event.lateAfterAt : event.checkInClosesAt)
          && data.arrivalStatus == "present")
          || (request.time >= (("lateAfterAt" in event) ? event.lateAfterAt : event.checkInClosesAt)
            && data.arrivalStatus == "late"))
        && data.status == "checked-in"
        && !data.keys().hasAny(["recordSource", "correctionId", "correctedBy", "correctedAt", "correctionReason"])
        && !data.keys().hasAny(["checkedOutAt", "checkOutLocation"])
        && withinSparkGeofence(data, data.eventId, event);
    }

    function studentCanCheckOut(attendanceId, data, previous) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      return isStudent()
        && previous.studentUid == request.auth.uid
        && data.studentUid == request.auth.uid
        && attendanceId == request.auth.uid + "_" + previous.eventId
        && data.eventId == previous.eventId
        && previous.checkedInAt is timestamp
        && !previous.keys().hasAny(["checkedOutAt"])
        && previous.status == "checked-in" && data.status == "completed"
        && data.checkedOutAt == request.time
        && request.time >= event.closeAt && request.time <= event.checkOutClosesAt
        && data.diff(previous).affectedKeys().hasOnly(["checkOutLocation", "checkedOutAt", "status"])
        && (!data.keys().hasAny(["checkOutLocation"]) || validLocation(data.checkOutLocation))
        && (event.requiresGeofence != true || data.keys().hasAll(["checkOutLocation"]))
        && (!event.requiresGeofence || withinSparkGeofence({ "checkInLocation": data.checkOutLocation }, data.eventId, event));
    }

    function studentCanRecordCheckoutOnly(attendanceId, data) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      let student = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return isStudent()
        && !('checkoutOnlyReopened' in event)
        && attendanceId == request.auth.uid + "_" + data.eventId
        && exists(/databases/$(database)/documents/events/$(data.eventId))
        && exists(/databases/$(database)/documents/faceRegistrations/$(request.auth.uid))
        && get(/databases/$(database)/documents/faceRegistrations/$(request.auth.uid)).data.registered == true
        && data.studentUid == request.auth.uid && data.studentId == student.accountId
        && attendanceMatchesEvent(data, event) && eligibleForAttendance(event, student, request.auth.uid)
        && data.status == "checkout-only" && data.arrivalStatus == "absent" && data.checkedOutAt == request.time
        && request.time >= event.closeAt && request.time <= event.checkOutClosesAt
        && !data.keys().hasAny(["attendedAt", "checkedInAt", "checkInLocation", "recordSource", "correctionId", "correctedBy", "correctedAt", "correctionReason"])
        && (!data.keys().hasAny(["checkOutLocation"]) || validLocation(data.checkOutLocation))
        && (event.requiresGeofence != true || data.keys().hasAll(["checkOutLocation"]))
        && (!event.requiresGeofence || withinSparkGeofence({ "checkInLocation": data.checkOutLocation }, data.eventId, event));
    }

    // A correction and its immutable before/after audit must be committed together.
    function validAdminCorrection(attendanceId, data, before) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      let student = get(/databases/$(database)/documents/students/$(data.studentUid)).data;
      let audit = getAfter(/databases/$(database)/documents/attendance/$(attendanceId)/corrections/$(data.correctionId)).data;
      return canManageAttendance() && validAttendance(data)
        && attendanceId == data.studentUid + "_" + data.eventId
        && student.active == true && data.studentId == student.accountId
        && eligibleForAttendance(event, student, data.studentUid)
        && attendanceMatchesEvent(data, event)
        && data.recordSource == "admin-corrected" && data.correctedBy == request.auth.uid
        && shortText(data.correctionId, 128) && data.correctionId.matches('^[A-Za-z0-9_-]+$')
        && data.correctedAt == request.time
        && shortText(data.correctionReason, 1000) && data.correctionReason.size() >= 5
        && data.attendedAt == data.checkedInAt && data.checkedInAt <= request.time
        && ((data.status == "completed" && data.checkedOutAt >= data.checkedInAt && data.checkedOutAt <= request.time)
          || (data.status == "checked-in" && !data.keys().hasAny(["checkedOutAt", "checkOutLocation"])))
        && data.keys().hasAll(["arrivalStatus"])
        && audit.keys().hasOnly(["before", "after", "by", "at", "reason"])
        && audit.before == before && audit.after == data
        && audit.by == request.auth.uid && audit.at == request.time && audit.reason == data.correctionReason;
    }

    match /students/{studentUid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == studentUid);
      allow list: if isAdmin();
      allow create: if (canManageStudents()
          && validStudent(request.resource.data)
          && !request.resource.data.keys().hasAny(["passwordResetRequired", "passwordResetValidAfter"])
          && (!request.resource.data.keys().hasAny(["role"]) || request.resource.data.role == "student")
          && !request.resource.data.keys().hasAny(["roleUpdatedAt", "roleUpdatedBy"]))
        || (validStudent(request.resource.data)
          && !request.resource.data.keys().hasAny(["passwordResetRequired", "passwordResetValidAfter"])
          && approvedRegistration(request.resource.data.accountIdKey, request.resource.data.uid)
          && request.resource.data.uid == studentUid
          && request.resource.data.role == "student" && request.resource.data.active == true);
      allow delete: if isSuperAdmin();
      allow update: if (isSuperAdmin()
          && resource.data.get("passwordResetRequired", false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "roleUpdatedAt", "roleUpdatedBy"])
          && request.resource.data.role in ["head_admin", "attendance_admin", "student_manager", "student"]
          && request.resource.data.roleUpdatedAt is timestamp
          && request.resource.data.roleUpdatedBy == request.auth.uid)
        || (canManageStudents()
          && validStudent(request.resource.data)
          && (!isStudentManager() || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "accountId", "accountIdKey", "firstName", "middleName", "lastName", "birthday", "gender", "course", "section", "email", "phone", "photoDataUrl", "updatedAt", "grade", "adviser"
          ]))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "roleUpdatedAt", "roleUpdatedBy", "passwordResetRequired", "passwordResetValidAfter"]))
        || (isStudent()
          && request.auth.uid == studentUid
          && validStudent(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "accountId", "accountIdKey", "firstName", "middleName", "lastName", "birthday", "gender", "course", "section", "email", "phone", "photoDataUrl", "updatedAt"
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && (!("photoDataUrl" in request.resource.data)
            || (request.resource.data.photoDataUrl is string
              && request.resource.data.photoDataUrl.size() <= 350000))
          && request.resource.data.section in ["1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B"])
        || (isStudent()
          && request.auth.uid == studentUid
          && resource.data.mustChangePassword == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword", "updatedAt"])
          && request.resource.data.updatedAt is timestamp);
    }

    // An event and its push outbox request are saved in one client batch. Only
    // the backend reads jobs, device tokens, delivery cursors and schedules.
    match /eventPushOutbox/{eventId} {
      allow create, update: if canManageAttendance()
        && request.resource.data.keys().hasOnly(["eventId", "pending", "requestedAt"])
        && request.resource.data.eventId == eventId
        && request.resource.data.pending == true
        && request.resource.data.requestedAt == request.time
        && existsAfter(/databases/$(database)/documents/events/$(eventId));
      allow read, delete: if false;
    }

    match /adminProfiles/{adminUid} {
      allow read, create, update: if isSuperAdmin() && request.auth.uid == adminUid;
      allow delete: if false;
    }

    // Normalized Student IDs are used as document names. A duplicate write is
    // an update, and updates are denied, so the same ID cannot be registered twice.
    match /studentIds/{studentIdKey} {
      allow read: if signedIn();
      allow create: if (canManageStudents() || approvedRegistration(studentIdKey, request.resource.data.uid))
        && !exists(/databases/$(database)/documents/studentIds/$(studentIdKey))
        && (canManageStudents() || request.resource.data.uid == request.auth.uid);
      allow update: if false;
      allow delete: if canManageStudents() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /registrationRequests/{requestId} {
      allow get: if isSuperAdmin() || isHeadAdmin() || isStudentManager() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isSuperAdmin() || isHeadAdmin() || isStudentManager();
      allow create: if signedIn() && validRegistrationRequest(request.resource.data, requestId);
      allow update: if validRegistrationReapplication(request.resource.data)
        || ((isSuperAdmin() || isHeadAdmin())
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy", "updatedAt"])
        && request.resource.data.status in ["approved", "declined"]
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid);
      allow delete: if false;
    }

    match /events/{eventId} {
      // Students cannot read legacy events that embed geofence coordinates.
      allow read: if isSuperAdmin() || isHeadAdmin() || isAttendanceAdmin() || isStudentManager()
        || (isStudent() && !resource.data.keys().hasAll(["geofence"]));
      allow create, update: if canManageAttendance()
        && validEvent(request.resource.data)
        && validSession(request.resource.data, eventId)
        && request.resource.data.openAt < request.resource.data.checkInClosesAt
        && request.resource.data.checkInClosesAt <= request.resource.data.closeAt
        && request.resource.data.closeAt < request.resource.data.checkOutClosesAt
        && (!exists(/databases/$(database)/documents/events/$(eventId))
          ? (request.resource.data.keys().hasAll(["attendanceRoster", "rosterCapturedAt"])
            && request.resource.data.rosterCapturedAt == request.time)
          : validRosterUpdate(request.resource.data, resource.data));
      // Deletion is deliberately stricter than event editing. This protects
      // the operational-data reset from being triggered by other admin roles.
      allow delete: if isSuperAdmin();
    }


    // Surveys never write attendance/fines. Browser GPS evidence is not trusted GPS.
    function canManageSurveys() {
      return isSuperAdmin() || isHeadAdmin() || isAttendanceAdmin();
    }
    function canReadSurvey(eventId) {
      return canManageSurveys() || (isSurveyStudent()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && eligibleForAttendance(get(/databases/$(database)/documents/events/$(eventId)).data,
          get(/databases/$(database)/documents/students/$(request.auth.uid)).data, request.auth.uid));
    }
    function isSurveyStudent() {
      let profile = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return isStudent() && (!("role" in profile) || profile.role in ["student", "viewer"]);
    }
    function validSurveyChoices(choices) {
      // Authorized editors validate every choice in SurveyPolicy. Keep config
      // checks bounded for 20 agendas; submitted values must be strings in choices.
      return choices is list && choices.size() <= 8 && choices.toSet().size() == choices.size();
    }
    function validSurveyQuestion(question, index) {
      return question is map
        && question.id == "q" + string(index)
        && shortText(question.text, 500) && question.text.size() > 0
        && question.type in ["choice", "text"]
        && validSurveyChoices(question.choices)
        && (question.type == "text" ? question.choices.size() == 0 : question.choices.size() >= 2);
    }
    function validSurveyQuestions(questions) {
      return questions is list && questions.size() >= 1 && questions.size() <= 20
        && (questions.size() <= 0 || validSurveyQuestion(questions[0], 0))
        && (questions.size() <= 1 || validSurveyQuestion(questions[1], 1))
        && (questions.size() <= 2 || validSurveyQuestion(questions[2], 2))
        && (questions.size() <= 3 || validSurveyQuestion(questions[3], 3))
        && (questions.size() <= 4 || validSurveyQuestion(questions[4], 4))
        && (questions.size() <= 5 || validSurveyQuestion(questions[5], 5))
        && (questions.size() <= 6 || validSurveyQuestion(questions[6], 6))
        && (questions.size() <= 7 || validSurveyQuestion(questions[7], 7))
        && (questions.size() <= 8 || validSurveyQuestion(questions[8], 8))
        && (questions.size() <= 9 || validSurveyQuestion(questions[9], 9))
        && (questions.size() <= 10 || validSurveyQuestion(questions[10], 10))
        && (questions.size() <= 11 || validSurveyQuestion(questions[11], 11))
        && (questions.size() <= 12 || validSurveyQuestion(questions[12], 12))
        && (questions.size() <= 13 || validSurveyQuestion(questions[13], 13))
        && (questions.size() <= 14 || validSurveyQuestion(questions[14], 14))
        && (questions.size() <= 15 || validSurveyQuestion(questions[15], 15))
        && (questions.size() <= 16 || validSurveyQuestion(questions[16], 16))
        && (questions.size() <= 17 || validSurveyQuestion(questions[17], 17))
        && (questions.size() <= 18 || validSurveyQuestion(questions[18], 18))
        && (questions.size() <= 19 || validSurveyQuestion(questions[19], 19));
    }
    function validSurveyConfig(data, eventId) {
      return data.keys().hasOnly(["eventId", "enabled", "revision", "locationMode", "questions", "opensAt", "closesAt", "createdAt", "createdBy", "updatedAt", "archived", "deleting"])
        && data.keys().hasAll(["eventId", "enabled", "revision", "locationMode", "questions", "opensAt", "closesAt", "createdAt", "createdBy", "updatedAt"])
        && data.eventId == eventId && data.enabled is bool && data.revision == 1
        && (!("archived" in data) || data.archived is bool)
        && (!("deleting" in data) || data.deleting is bool)
        && (!("archived" in data) || !data.archived || !data.enabled)
        && (!("deleting" in data) || !data.deleting || (data.archived == true && !data.enabled))
        && data.locationMode in ["start-only", "start-finish"]
        && data.opensAt is timestamp && data.closesAt is timestamp && data.opensAt < data.closesAt
        && data.createdAt is timestamp && data.createdBy is string && data.updatedAt == request.time
        && validSurveyQuestions(data.questions);
    }
    function validSurveyResponse(data, eventId, uid) {
      return data.keys().hasOnly(["studentUid", "studentId", "studentName", "eventId", "surveyRevision", "answers", "answerCount", "status", "startedAt", "updatedAt",
          "startEvidence", "finishEvidence", "reviewReason", "reviewIssue", "reviewStage", "reviewRequestedAt",
          "reviewDecision", "reviewNote", "reviewedBy", "reviewedAt", "reviewAuditId"])
        && data.keys().hasAll(["studentUid", "studentId", "studentName", "eventId", "surveyRevision", "answers", "answerCount", "status", "startedAt", "updatedAt"])
        && shortText(data.studentId, 64)
        && shortText(data.studentName, 200)
        && data.studentUid == uid && data.eventId == eventId
        && data.surveyRevision == get(/databases/$(database)/documents/eventSurveys/$(eventId)).data.revision
        && data.answers is map && data.answerCount is int && data.answerCount >= 0 && data.answerCount <= 20
        && data.answers.size() == data.answerCount
        && data.status in ["in-progress", "completed", "needs-review"]
        && data.startedAt is timestamp && data.updatedAt == request.time;
    }
    function validSurveyEvidence(evidence) {
      return evidence is map && evidence.keys().hasOnly(["result", "method", "accuracy", "boundaryType", "checkedAt"])
        && evidence.keys().hasAll(["result", "method", "accuracy", "boundaryType", "checkedAt"])
        && evidence.result in ["inside", "reviewed"] && evidence.method == "browser"
        && evidence.boundaryType in ["circle", "polygon", "review"]
        && evidence.accuracy is number && evidence.accuracy >= 0 && evidence.accuracy <= 50
        && evidence.checkedAt == request.time;
    }
    function approvedSurveyReview(previous, stage) {
      return previous != null && previous.keys().hasAll(["reviewDecision", "reviewStage", "reviewedAt", "reviewRequestedAt"])
        && previous.reviewDecision == "approved" && previous.reviewStage == stage
        && previous.reviewedAt >= previous.reviewRequestedAt;
    }
    function validSurveyStage(evidence, previous, stage) {
      return validSurveyEvidence(evidence)
        && (evidence.result == "inside"
          ? evidence.boundaryType in ["circle", "polygon"]
          : (evidence.boundaryType == "review" && approvedSurveyReview(previous, stage)));
    }
    function validSurveyAnswer(eventId, data, previous) {
      let config = get(/databases/$(database)/documents/eventSurveys/$(eventId)).data;
      let index = previous == null ? 0 : previous.answerCount;
      let question = config.questions[index];
      let answer = data.answers[question.id];
      let finalAnswer = data.answerCount == config.questions.size();
      return surveyAcceptsWrites(eventId) && config.enabled == true && request.time >= config.opensAt && request.time <= config.closesAt
        && (previous == null || previous.status != "needs-review")
        && data.answerCount == index + 1
        && data.status == (finalAnswer ? "completed" : "in-progress")
        && answer is map && answer.keys().hasOnly(["value", "answeredAt"]) && answer.keys().hasAll(["value", "answeredAt"])
        && shortText(answer.value, 1000) && answer.value.size() > 0 && answer.answeredAt == request.time
        && (question.type == "text" || answer.value in question.choices)
        && (previous == null
          ? (data.startedAt == request.time && data.answers.keys().hasOnly([question.id])
            && data.keys().hasOnly(["studentUid", "studentId", "studentName", "eventId", "surveyRevision", "answers", "answerCount", "status", "startedAt", "updatedAt", "startEvidence", "finishEvidence"]))
          : (data.diff(previous).affectedKeys().hasOnly(["answers", "answerCount", "status", "updatedAt", "startEvidence", "finishEvidence"])
            && data.answers.diff(previous.answers).affectedKeys().hasOnly([question.id])))
        && (index == 0
          ? (data.keys().hasAll(["startEvidence"]) && validSurveyStage(data.startEvidence, previous, "start"))
          : data.startEvidence == previous.startEvidence)
        && (finalAnswer && config.locationMode == "start-finish"
          ? (data.keys().hasAll(["finishEvidence"])
            && (index == 0 ? data.finishEvidence == data.startEvidence : validSurveyStage(data.finishEvidence, previous, "finish")))
          : !("finishEvidence" in data));
    }
    function validSurveyReviewRequest(eventId, data, previous) {
      let config = get(/databases/$(database)/documents/eventSurveys/$(eventId)).data;
      let count = previous == null ? 0 : previous.answerCount;
      let stage = count == 0 ? "start" : (config.locationMode == "start-finish" && count == config.questions.size() - 1 ? "finish" : "other");
      return surveyAcceptsWrites(eventId) && count < config.questions.size() && data.answerCount == count && data.status == "needs-review"
        && data.keys().hasAll(["reviewReason", "reviewIssue", "reviewStage", "reviewRequestedAt"])
        && shortText(data.reviewReason, 1000) && data.reviewReason.size() > 0
        && data.reviewIssue in ["outside", "unavailable"] && data.reviewStage == stage && data.reviewRequestedAt == request.time
        && (previous == null
          ? (data.startedAt == request.time && data.answers.size() == 0
            && data.keys().hasOnly(["studentUid", "studentId", "studentName", "eventId", "surveyRevision", "answers", "answerCount", "status", "startedAt", "updatedAt", "reviewReason", "reviewIssue", "reviewStage", "reviewRequestedAt"]))
          : data.diff(previous).affectedKeys().hasOnly(["status", "reviewReason", "reviewIssue", "reviewStage", "reviewRequestedAt", "updatedAt"]));
    }

    function surveyAcceptsWrites(eventId) {
      let config = get(/databases/$(database)/documents/eventSurveys/$(eventId)).data;
      return (!("archived" in config) || !config.archived) && (!("deleting" in config) || !config.deleting);
    }
    function surveyIsDeleting(eventId) {
      let config = get(/databases/$(database)/documents/eventSurveys/$(eventId)).data;
      return config.keys().hasAll(["archived", "deleting"]) && config.archived == true && config.deleting == true && config.enabled == false;
    }
    match /eventSurveys/{eventId} {
      allow get: if canReadSurvey(eventId);
      allow list: if canManageSurveys();
      allow create: if canManageSurveys()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && exists(/databases/$(database)/documents/eventGeofences/$(eventId))
        && get(/databases/$(database)/documents/eventGeofences/$(eventId)).data.enabled == true
        && validSurveyConfig(request.resource.data, eventId)
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if canManageSurveys() && validSurveyConfig(request.resource.data, eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["enabled", "updatedAt", "archived", "deleting"])
        && (!("deleting" in resource.data) || !resource.data.deleting || request.resource.data.deleting == true);
      allow delete: if canManageSurveys() && surveyIsDeleting(eventId);

      match /responses/{uid} {
        allow get: if canManageSurveys() || (canReadSurvey(eventId) && request.auth.uid == uid);
        allow list: if canManageSurveys();
        allow create: if signedIn() && isSurveyStudent() && request.auth.uid == uid && studentCanReadEventGeofence(eventId)
          && request.resource.data.studentId == get(/databases/$(database)/documents/students/$(uid)).data.accountId
          && validSurveyResponse(request.resource.data, eventId, uid)
          && (validSurveyReviewRequest(eventId, request.resource.data, null) || validSurveyAnswer(eventId, request.resource.data, null));
        allow update: if
          (signedIn() && isSurveyStudent() && request.auth.uid == uid && studentCanReadEventGeofence(eventId)
            && resource.data.status != "completed"
            && validSurveyResponse(request.resource.data, eventId, uid)
            && (validSurveyReviewRequest(eventId, request.resource.data, resource.data) || validSurveyAnswer(eventId, request.resource.data, resource.data)))
          || (canManageSurveys() && !surveyIsDeleting(eventId) && resource.data.status == "needs-review"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reviewDecision", "reviewNote", "reviewedBy", "reviewedAt", "reviewAuditId", "updatedAt", "status"])
            && request.resource.data.reviewDecision in ["approved", "declined"]
            && shortText(request.resource.data.reviewNote, 1000) && request.resource.data.reviewNote.size() > 0
            && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
            && request.resource.data.updatedAt == request.time && request.resource.data.status == "in-progress"
            && shortText(request.resource.data.reviewAuditId, 128) && request.resource.data.reviewAuditId.size() > 0
            && getAfter(/databases/$(database)/documents/eventSurveys/$(eventId)/responses/$(uid)/reviews/$(request.resource.data.reviewAuditId)).data.actorUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/eventSurveys/$(eventId)/responses/$(uid)/reviews/$(request.resource.data.reviewAuditId)).data.reviewedAt == request.time);
        allow delete: if canManageSurveys() && surveyIsDeleting(eventId);
        match /reviews/{reviewId} {
          allow read: if canManageSurveys();
          allow create: if canManageSurveys() && !surveyIsDeleting(eventId)
            && request.resource.data.keys().hasOnly(["actorUid", "decision", "note", "stage", "requestedAt", "reviewedAt"])
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.decision in ["approved", "declined"]
            && shortText(request.resource.data.note, 1000) && request.resource.data.note.size() > 0
            && request.resource.data.stage in ["start", "finish", "other"]
            && request.resource.data.requestedAt is timestamp
            && getAfter(/databases/$(database)/documents/eventSurveys/$(eventId)/responses/$(uid)).data.reviewedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/eventSurveys/$(eventId)/responses/$(uid)).data.reviewedAt == request.time
            && getAfter(/databases/$(database)/documents/eventSurveys/$(eventId)/responses/$(uid)).data.reviewDecision == request.resource.data.decision
            && getAfter(/databases/$(database)/documents/eventSurveys/$(eventId)/responses/$(uid)).data.reviewNote == request.resource.data.note
            && getAfter(/databases/$(database)/documents/eventSurveys/$(eventId)/responses/$(uid)).data.reviewStage == request.resource.data.stage
            && getAfter(/databases/$(database)/documents/eventSurveys/$(eventId)/responses/$(uid)).data.reviewRequestedAt == request.resource.data.requestedAt;
          allow update: if false;
          allow delete: if canManageSurveys() && surveyIsDeleting(eventId);
        }
      }
    }

    function validCorrectionRequestCreate(requestId, data) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      let student = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      let history = getAfter(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId)/history/submitted).data;
      return isStudent() && student.get("role", "student") == "student"
        && data.keys().hasOnly(["studentUid", "eventId", "kind", "reason", "status", "submittedAt"])
        && data.studentUid == request.auth.uid && requestId == data.studentUid + "_" + data.eventId
        && shortText(data.eventId, 128) && data.eventId.matches('^[A-Za-z0-9_-]+$')
        && data.kind in ["missed-check-in", "missed-checkout", "incorrect-attendance"]
        && shortText(data.reason, 1000) && data.reason.size() >= 5
        && data.status == "pending" && data.submittedAt == request.time
        && request.time > event.checkOutClosesAt && eligibleForAttendance(event, student, data.studentUid)
        && history == {"action": "submitted", "by": data.studentUid, "at": request.time, "reason": data.reason, "correctionId": ""};
    }
    function correctionReviewerName() {
      return isSuperAdmin() ? superAdminReviewerName() : assignedReviewerName();
    }
    function superAdminReviewerName() {
      let path = /databases/$(database)/documents/adminProfiles/$(request.auth.uid);
      let name = exists(path) ? get(path).data.get("displayName", "") : "";
      return name is string && name.size() > 0 && name.size() <= 256 ? name : "Super Admin";
    }
    function assignedReviewerName() {
      let profile = get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      let first = profile.get("firstName", "");
      let middle = profile.get("middleName", "");
      let last = profile.get("lastName", "");
      let name = first + (middle.size() > 0 ? (first.size() > 0 ? " " : "") + middle : "")
        + (last.size() > 0 ? (first.size() > 0 || middle.size() > 0 ? " " : "") + last : "");
      return name.size() > 0 && name.size() <= 256 ? name : "Administrator";
    }
    function validCorrectionRequestDecision(requestId, data, before) {
      let history = getAfter(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId)/history/decision).data;
      return canManageAttendance() && before.status == "pending"
        && data.keys().hasOnly(["studentUid", "eventId", "kind", "reason", "status", "submittedAt", "reviewedBy", "reviewedByName", "reviewedAt", "decisionReason", "correctionId"])
        && data.diff(before).affectedKeys().hasOnly(["status", "reviewedBy", "reviewedByName", "reviewedAt", "decisionReason", "correctionId"])
        && data.reviewedBy == request.auth.uid && data.reviewedAt == request.time
        && data.reviewedByName == correctionReviewerName()
        && shortText(data.decisionReason, 1000) && data.decisionReason.size() >= 5
        && history == {"action": data.status, "by": request.auth.uid, "byName": data.reviewedByName, "at": request.time, "reason": data.decisionReason, "correctionId": data.correctionId}
        && ((data.status == "declined" && data.correctionId == "")
          || (data.status == "approved" && approvedRequestCorrection(data)));
    }
    function approvedRequestCorrection(data) {
      let attendanceId = data.studentUid + "_" + data.eventId;
      let attendance = getAfter(/databases/$(database)/documents/attendance/$(attendanceId)).data;
      let audit = getAfter(/databases/$(database)/documents/attendance/$(attendanceId)/corrections/$(data.correctionId)).data;
      return shortText(data.correctionId, 128) && data.correctionId.size() > 0
        && attendance.studentUid == data.studentUid && attendance.eventId == data.eventId
        && attendance.correctedAt == request.time && attendance.correctedBy == request.auth.uid
        && attendance.correctionId == data.correctionId && attendance.correctionReason == data.decisionReason
        && audit.after == attendance && audit.by == request.auth.uid && audit.at == request.time;
    }
    match /attendanceCorrectionRequests/{requestId} {
      allow get: if canManageAttendance() || (isStudent() && (
        exists(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId))
          ? resource.data.studentUid == request.auth.uid
          : (request.auth.uid.matches('^[A-Za-z0-9_-]+$') && requestId.matches('^' + request.auth.uid + '_[A-Za-z0-9_-]+$'))));
      allow list: if canManageAttendance() || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if validCorrectionRequestCreate(requestId, request.resource.data);
      allow update: if validCorrectionRequestDecision(requestId, request.resource.data, resource.data);
      allow delete: if false;
      match /history/{entryId} {
        allow read: if canManageAttendance() || (isStudent() && get(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId)).data.studentUid == request.auth.uid);
        allow create: if (entryId == "submitted"
            && !exists(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId))
            && getAfter(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId)).data.studentUid == request.auth.uid
            && validCorrectionRequestCreate(requestId, getAfter(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId)).data))
          || (entryId == "decision" && canManageAttendance()
            && validCorrectionRequestDecision(requestId, getAfter(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId)).data,
              get(/databases/$(database)/documents/attendanceCorrectionRequests/$(requestId)).data));
        allow update, delete: if false;
      }
    }

    match /attendance/{attendanceId} {
      // A student's deterministic document may not exist before the first check-in.
      // Only missing documents in their own namespace can use this exception.
      allow get: if canViewAttendanceReports()
        || (isStudent() && (
          exists(/databases/$(database)/documents/attendance/$(attendanceId))
            ? resource.data.studentUid == request.auth.uid
            : (request.auth.uid.matches('^[A-Za-z0-9_-]+$')
              && attendanceId.matches('^' + request.auth.uid + '_[A-Za-z0-9_-]+$'))
        ));
      // Queries must still be constrained to the student's own records.
      allow list: if canViewAttendanceReports()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if (canManageAttendance()
          && request.resource.data.keys().hasAll(["correctionId", "recordSource", "correctedBy", "correctedAt", "correctionReason"])
          && validAdminCorrection(attendanceId, request.resource.data, null))
        || (validAttendance(request.resource.data) && studentCanCheckIn(attendanceId, request.resource.data))
        || (validAttendance(request.resource.data) && studentCanRecordCheckoutOnly(attendanceId, request.resource.data));
      allow update: if (canManageAttendance()
          && request.resource.data.keys().hasAll(["correctionId", "recordSource", "correctedBy", "correctedAt", "correctionReason"])
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.eventId == resource.data.eventId
          && validAdminCorrection(attendanceId, request.resource.data, resource.data))
        || (canManageAttendance() && validAttendance(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["eventName", "eventType", "eventDescription", "eventDate", "timeIn", "timeOut", "location", "audience"])
          && attendanceMatchesEvent(request.resource.data, get(/databases/$(database)/documents/events/$(resource.data.eventId)).data))
        // Validate the checkout patch, not unrelated legacy check-in metadata.
        // studentCanCheckOut keeps every original check-in field immutable.
        || studentCanCheckOut(attendanceId, request.resource.data, resource.data);
      allow delete: if isSuperAdmin();

      match /corrections/{correctionId} {
        allow read: if canViewAttendanceReports()
          || (isStudent() && get(/databases/$(database)/documents/attendance/$(attendanceId)).data.studentUid == request.auth.uid);
        allow create: if canManageAttendance()
          && request.resource.data.after.correctionId == correctionId
          && request.resource.data.after == getAfter(/databases/$(database)/documents/attendance/$(attendanceId)).data
          && validAdminCorrection(attendanceId, request.resource.data.after,
            exists(/databases/$(database)/documents/attendance/$(attendanceId)) ? get(/databases/$(database)/documents/attendance/$(attendanceId)).data : null);
        allow update, delete: if false;
      }
    }

    function confirmedFineAbsence(data) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      return data.eventId is string && data.eventId.size() > 0
        && event.checkOutClosesAt is timestamp && request.time > event.checkOutClosesAt
        && 'attendanceRoster' in event && event.attendanceRoster is map
        && data.studentUid in event.attendanceRoster
        && !exists(/databases/$(database)/documents/attendance/$(data.studentUid + '_' + data.eventId));
    }

    match /fines/{fineId} {
      allow read: if canViewFines()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if canManageFines() && validFine(request.resource.data)
        && confirmedFineAbsence(request.resource.data);
      allow update: if canManageFines() && validFine(request.resource.data)
        && ((request.resource.data.studentUid == resource.data.studentUid
            && request.resource.data.eventId == resource.data.eventId)
          || confirmedFineAbsence(request.resource.data));
      allow delete: if isSuperAdmin();
    }

    match /dismissedHistory/{dismissalId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow delete: if isSuperAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid;
      allow update: if false;
    }

    match /faceResetRequests/{requestId} {
      allow get: if canManageStudents()
        && (!exists(/databases/$(database)/documents/faceResetRequests/$(requestId))
          || resource.data.requesterUid == request.auth.uid);
      allow list: if isSuperAdmin();
      allow create: if canManageStudents()
        && requestId.matches('[A-Za-z0-9_-]{16,128}')
        && request.resource.data.keys().hasOnly(['studentUid', 'requesterUid', 'status', 'outcome', 'error', 'recoveryReason', 'completedAt'])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.studentUid is string
        && request.resource.data.studentUid.matches('[A-Za-z0-9_-]{1,128}')
        && request.resource.data.status in ['completed', 'failed']
        && request.resource.data.outcome in ['', 'trashed', 'already_trashed', 'missing_recovered', 'already_reset']
        && request.resource.data.error is string && request.resource.data.error.size() <= 1000
        && request.resource.data.recoveryReason is string && request.resource.data.recoveryReason.size() <= 500
        && request.resource.data.completedAt is timestamp
        && (request.resource.data.outcome != 'missing_recovered'
          || ((isSuperAdmin() || isHeadAdmin()) && request.resource.data.recoveryReason.size() >= 10))
        && (request.resource.data.status != 'completed'
          || !existsAfter(/databases/$(database)/documents/faceRegistrations/$(request.resource.data.studentUid)));
      allow update, delete: if false;
    }

    match /faceRegistrations/{studentUid} {
      allow read: if isAdmin() || (isStudent() && request.auth.uid == studentUid);
      allow create, update: if isStudent()
        && request.auth.uid == studentUid
        && request.resource.data.registered == true;
      allow delete: if canManageStudents();
    }

    match /eventGeofences/{eventId} {
      // Eligible students need a single geofence document to calculate the
      // exact client-side distance. Listing all attendance areas stays denied.
      allow get: if canManageAttendance() || studentCanReadEventGeofence(eventId);
      allow list: if canManageAttendance();
      allow create: if canManageAttendance() && validGeofence(request.resource.data);
      // Event-group saves also send unchanged areas. A no-op needs no repeated
      // 10-vertex validation; any actual area change still validates fully.
      allow update: if canManageAttendance()
        && (request.resource.data == resource.data || validGeofence(request.resource.data));
      allow delete: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      // Notifications belong to one account. Roles determine who receives a
      // notification, not who can read a shared administrator inbox.
      allow read, delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && validNotification(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"]);
      allow create: if (canManageAttendance() || canManageStudents())
          && validNotification(request.resource.data)
        || (isStudent()
          && validNotification(request.resource.data)
          && request.resource.data.category == "face"
          && request.resource.data.recipientUid == request.auth.uid
          && request.resource.data.recipientRole == "");
    }

    match /presence/{studentUid} {
      allow read: if isAdmin()
        || (isStudent() && request.auth.uid == studentUid);
      allow create, update: if isStudent()
        && request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly(["online", "status", "lastSeen", "offlineAt"])
        && request.resource.data.online is bool
        && request.resource.data.status in ["online", "offline", "logged-out"]
        && request.resource.data.lastSeen is timestamp
        && (!("offlineAt" in request.resource.data)
          || request.resource.data.offlineAt is timestamp);
      allow delete: if isSuperAdmin();
    }

    match /presenceSessions/{sessionId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.keys().hasOnly(["studentUid", "sessionId", "online", "status", "lastSeen", "offlineAt"])
        && request.resource.data.online is bool
        && request.resource.data.status in ["online", "offline", "logged-out"]
        && request.resource.data.lastSeen is timestamp
        && (!("offlineAt" in request.resource.data)
          || request.resource.data.offlineAt is timestamp);
      allow update: if isStudent()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.keys().hasOnly(["studentUid", "sessionId", "online", "status", "lastSeen", "offlineAt"])
        && request.resource.data.online is bool
        && request.resource.data.status in ["online", "offline", "logged-out"]
        && request.resource.data.lastSeen is timestamp
        && (!("offlineAt" in request.resource.data)
          || request.resource.data.offlineAt is timestamp);
      allow delete: if isSuperAdmin();
    }

    match /auditLogs/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
