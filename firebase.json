{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.audience-test.json",
      "AGENTS.md",
      "firestore.rules",
      "**/.*",
      ".android-tools/**",
      "android/**",
      "mobile/**",
      "mobile-web/**",
      "**/*.log",
      "**/*firebase-adminsdk-*.json",
      "**/presence-a873f-*.json",
      "**/service-account*.json",
      "**/firebase-service-account*.json",
      "**/*.firebase-admin.json",
      "**/*.pem",
      "**/*.key",
      "**/*.jks",
      "**/*.keystore",
      "docs/**",
      "tests/**",
      "tools/**",
      "workers/**",
      "package.json",
      "package-lock.json",
      "node_modules/**",
      ".firebaserc",
      "functions/**",
      ".git/**",
      ".agents/**",
      ".codex/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "cleanUrls": true
  }
}
